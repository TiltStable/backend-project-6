<% layout("../layouts/application", { header: it.t('views.labels.edit.edit') }) %>
<div class="mx-auto max-w-md rounded bg-white p-8 shadow-sm">
  <form action="<%= it.route('updateLabel', { id: it.label.id }) %>" method="post">
    <input name="_method" type="hidden" value="patch">
    <%~ include("../mixins/input", { entity: it.label, propertyName: 'name', errors: it.errors, type: 'text' }) %>
    <%~ include("../mixins/submit", { value: it.t('views.labels.edit.submit') }) %>
  </form>
</div>
