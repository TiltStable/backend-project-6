<% layout("../layouts/application", { header: it.task.name }) %>
<div class="rounded bg-white p-6 shadow-sm">
  <div class="flex flex-col gap-6 md:flex-row">
    <div class="grow"><%= it.task.description %></div>
    <div class="md:w-64 md:border-l md:border-gray-200 md:pl-6">
      <span class="inline-block rounded bg-gray-200 px-2 py-1 text-sm text-gray-800"><%= it.statusName %></span>
      <div class="mt-4">
        <div class="text-gray-500"><%= it.t('views.tasks.show.author') %></div>
        <div><%= it.creatorName %></div>
      </div>
      <div class="mt-3">
        <div class="text-gray-500"><%= it.t('views.tasks.show.executor') %></div>
        <div><%= it.executorName %></div>
      </div>
      <div class="mt-3">
        <div class="text-gray-500"><%= it.t('views.tasks.show.createdAt') %></div>
        <div><%= it.formatDate(it.task.createdAt) %></div>
      </div>
      <div class="mt-4 flex items-center gap-2">
        <a
          class="cursor-pointer rounded bg-blue-600 px-2 py-1 text-sm text-white hover:bg-blue-700"
          href="<%= it.route('editTask', { id: it.task.id }) %>"
          ><%= it.t('views.tasks.buttons.edit') %></a
        >
        <% if (it.task.creatorId === it.currentUserId) { %>
        <%~ include("../mixins/buttonTo", {
          action: it.route('deleteTask', { id: it.task.id }),
          method: 'delete',
          class: 'cursor-pointer rounded bg-red-600 px-2 py-1 text-sm text-white hover:bg-red-700',
          value: it.t('views.tasks.buttons.delete'),
        }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>
